# HAProxy termine le TLS et relaie en HTTP ; Caddy ne fait que du routage par nom de domaine.
{
	auto_https off
	admin off
	servers {
		trusted_proxies static {$HAPROXY_IP}
		# IP cliente = dernière adresse de X-Forwarded-For non fiable, pas la première, que le
		# client peut écrire lui-même.
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

(security) {
	log {
		output stdout
		format json
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		# frame-ancestors ne peut pas être posé par une balise meta : la CSP du site (sources de scripts, etc.) vient du site lui-même.
		# « ? » : défaut seulement, deployd pose la sienne (plus stricte, avec nonce sur la page OAuth).
		?Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
		-Server
	}
}

(noindex) {
	header X-Robots-Tag "noindex, nofollow"
}

# Analytics Umami Cloud relayé depuis le domaine du site : pas de domaine tiers à autoriser, moins bloqué.
(umami) {
	handle_path /u/* {
		reverse_proxy https://cloud.umami.is {
			header_up Host cloud.umami.is
			header_up X-Forwarded-For {client_ip}
		}
	}
}

# Formulaire de contact. Le corps est limité ici aussi : deployd refuse au-delà de 32 Kio.
(api) {
	handle /api/* {
		request_body {
			max_size 64KiB
		}
		reverse_proxy deployd:8080 {
			header_up X-Real-IP {client_ip}
		}
	}
}

(static) {
	file_server
	encode zstd gzip
	@assets path_regexp \.[0-9a-f]{64}\.[a-z0-9]+$
	header @assets Cache-Control "public, max-age=31536000, immutable"
}

http://v2.tzama.fr {
	import security
	import noindex
	import umami
	import api
	# Maquettes aussi servies ici tant que test.tzama.fr n'est pas joignable ; l'ancienne adresse /home/ y mène.
	redir /home/* /maquettes{uri} permanent
	handle /maquettes/* {
		uri strip_prefix /maquettes
		root * /srv/sites/mockups
		import static
	}
	handle {
		root * /srv/sites/prod
		import static
	}
	handle_errors 404 {
		root * /srv/sites/prod
		rewrite * /404.html
		file_server
	}
}

http://test.tzama.fr {
	import security
	import noindex
	import umami
	import api
	handle /maquettes/* {
		uri strip_prefix /maquettes
		root * /srv/sites/mockups
		import static
	}
	handle {
		root * /srv/sites/previews
		import static
	}
	# chaque preview a sa propre 404.html
	handle_errors 404 {
		@pr path_regexp pr ^/(pr-[0-9]+)/
		handle @pr {
			root * /srv/sites/previews
			rewrite * /{re.pr.1}/404.html
			file_server
		}
		respond "Page introuvable" 404
	}
}

http://deploy.tzama.fr {
	import security
	import noindex
	# Le reste de deployd (/api/*) n'est servi que sous le domaine de chaque site.
	@deployd path /hooks/deploy /auth /callback /healthz
	handle @deployd {
		# Un peu au-dessus de la limite de deployd (512 Mio), qui répond lui-même 413.
		request_body {
			max_size 520MiB
		}
		reverse_proxy deployd:8080 {
			header_up X-Real-IP {client_ip}
		}
	}
	handle {
		respond 404
	}
}

# Bascule (domaine principal) : pas encore servi ici.
http://www.tzama.fr {
	redir https://tzama.fr{uri} permanent
}

http://tzama.fr {
	respond 404
}

:80 {
	respond 404
}
