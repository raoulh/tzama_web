# Configuration de deployd, copiée par install.sh dans /srv/tzama/deployd.env (0600) au premier
# passage, puis éditée sur la VM. Ce fichier-ci ne contient aucun secret.

# Secret partagé avec la CI (secret GitHub Actions du même nom) : openssl rand -hex 32
HOOK_SECRET=

# Application OAuth GitHub du CMS (callback : https://deploy.tzama.fr/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Vide : GitHub utilise la callback déclarée dans l'application OAuth
# OAUTH_REDIRECT_URL=https://deploy.tzama.fr/callback

# Sites autorisés à recevoir un jeton GitHub du CMS. Les previews (test.tzama.fr) n'y sont pas :
# elles publient le code d'une PR, qui pourrait sinon récupérer le jeton d'un éditeur connecté.
OAUTH_ALLOWED_ORIGINS=https://v2.tzama.fr
# Sites autorisés à envoyer le formulaire de contact
CONTACT_ALLOWED_ORIGINS=https://v2.tzama.fr,https://test.tzama.fr

# Formulaire de contact. Vide : le formulaire répond 503.
SMTP_HOST=
SMTP_PORT=587
# starttls (défaut ; tls si le port est 465) ou none
SMTP_TLS=starttls
# true : garde le chiffrement mais ne vérifie pas le certificat du serveur (auto-signé sur un
# réseau interne). Un avertissement est écrit au démarrage.
SMTP_TLS_SKIP_VERIFY=false
SMTP_USERNAME=
SMTP_PASSWORD=
# Adresse autorisée (SPF/DKIM) : enveloppe et en-tête From ; le parent est en Reply-To.
SMTP_FROM=
SMTP_FROM_NAME=Formulaire Tzama
CONTACT_TO=

# Valeurs par défaut, à ne changer qu'en connaissance de cause
# CONTACT_OK_PATH=/contact/merci/
# CONTACT_ERROR_PATH=/contact/
# CONTACT_RATE_LIMIT=5
# CONTACT_RATE_WINDOW=10m
# RELEASES_KEEP=5
# HOOK_MAX_BYTES=536870912
# HOOK_MAX_FILES=50000
# HOOK_MAX_UNPACKED_BYTES=2147483648
# HOOK_UPLOAD_TIMEOUT=5m
